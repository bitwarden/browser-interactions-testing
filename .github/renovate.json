{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>bitwarden/renovate-config"],
  "enabledManagers": ["custom.regex", "github-actions", "npm", "nvm"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|\\/)docker-compose\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s+(?<depName>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)\\s+#\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "groupName": "docker-compose minor",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "gh minor",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "bitwarden/lite carries the latest server, web client, and feature flag changes BIT tests against, so update it as soon as a release is available to keep test signal current",
      "groupName": "bitwarden lite",
      "matchPackageNames": ["ghcr.io/bitwarden/lite"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "schedule": ["at any time"],
      "minimumReleaseAge": "0 days"
    }
  ]
}
